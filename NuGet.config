<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- nuget.org ONLY, on purpose: this repository is open source, and anyone must be able to build it without an
       account or a token. Every package it needs, including Alcifra's module ABI, comes from there. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
