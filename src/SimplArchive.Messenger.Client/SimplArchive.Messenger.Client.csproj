<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The Messenger's client side, free of any user interface: the message format, the conversation keys and the key
         ring. Used by the SimplArchive app's Messages tile and by the standalone messenger app. -->
    <PackageId>SimplArchive.Messenger.Client</PackageId>
    <Version>0.8.0</Version>
    <Description>The SimplArchive Messenger's client library: end-to-end sealed messages and conversation keys, free of any user interface.</Description>
    <Authors>Hebel Consulting</Authors>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/HebelConsulting/SimplArchiveMessenger</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- MIT. The platform's CMS can address RSA recipients only; sealing a key to an elliptic-curve certificate needs this. -->
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
