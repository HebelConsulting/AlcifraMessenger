<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.13" />
    <!-- Pinned above the version EF brings, which carries a known high-severity vulnerability (the core pins the same). -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
    <!-- MIT. The real controllers in process, so the client library is tested against the wire it will meet. -->
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="10.0.13" />
    <!-- MIT. Opening a sealed key with a test certificate's private key, standing in for the hardware key. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SimplArchive.Messenger\SimplArchive.Messenger.csproj" />
    <ProjectReference Include="..\..\src\SimplArchive.Messenger.Client\SimplArchive.Messenger.Client.csproj" />
  </ItemGroup>

</Project>
